// Soft pastel clouds for Sky Lift: a wrapped key light from the low sun, a
// cool shadow side, and a bright rim where the sun catches the edges. The
// sky colors are eased with altitude, so the clouds follow the sky from
// sunset into night.

material {
  name: "LiftCloud",
  shading_model: unlit,
  blending: opaque,
  culling: back,
  parameters: [
    { type: vec4, name: lit_color, hint: source_color, default: [1.0, 0.86, 0.9, 1.0] },
    { type: vec4, name: shade_color, hint: source_color, default: [0.55, 0.5, 0.78, 1.0] },
    { type: vec4, name: sun_dir, default: [0.7, 0.2, -0.5, 0.0] },
  ],
}

fragment {
  void Surface(inout MaterialInputs material) {
    vec3 N = GetWorldNormal();
    vec3 V = GetViewDirection();
    vec3 L = normalize(material_params.sun_dir.xyz);
    float wrap = clamp(dot(N, L) * 0.5 + 0.5, 0.0, 1.0);
    vec3 c = mix(material_params.shade_color.rgb, material_params.lit_color.rgb, smoothstep(0.2, 0.9, wrap));
    float rim = pow(1.0 - clamp(dot(N, V), 0.0, 1.0), 3.0);
    c += material_params.lit_color.rgb * rim * 0.35 * wrap;
    material.base_color = vec4(c, 1.0);
    PrepareMaterial(material);
  }
}
