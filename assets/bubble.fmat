// Lumi's bubble: a soap film around a little warm light. Thin-film colors
// swirl over the surface and gather at the rim, a glint sits up top, and
// the light inside shows through the side facing the viewer. Drawn
// additively (a bubble is mostly the light it catches), scaled by `fade`.

material {
  name: "Bubble",
  shading_model: unlit,
  blending: additive,
  culling: none,
  depth_layer: 2,
  parameters: [
    { type: float, name: time, default: 0.0 },
    { type: float, name: fade, hint: range(0, 1, 0.01), default: 1.0 },
    { type: vec4, name: core_color, hint: source_color, default: [1.0, 0.62, 0.3, 1.0] },
    { type: float, name: core, hint: range(0, 4, 0.01), default: 1.0 },
  ],
}

fragment {
  void Surface(inout MaterialInputs material) {
    vec3 N = GetWorldNormal();
    vec3 V = GetViewDirection();
    vec3 P = GetWorldPosition();
    float t = material_params.time;
    float ndv = abs(dot(N, V));
    float fres = pow(1.0 - ndv, 2.4);

    // Thin-film interference: bands of color that drift and swirl.
    float film = ndv * 2.6 + P.y * 1.7 + sin(P.x * 6.0 + t * 1.4) * 0.5 + sin(P.y * 5.0 - t) * 0.3 + t * 0.35;
    vec3 iri = 0.5 + 0.5 * cos(6.2831853 * (film + vec3(0.0, 0.33, 0.67)));

    // A glint from above, and a softer one opposite.
    vec3 L = normalize(vec3(-0.45, 0.8, 0.4));
    float glint = pow(max(dot(N, normalize(L + V)), 0.0), 90.0);
    float back = pow(max(dot(N, normalize(-L + V)), 0.0), 30.0);

    vec3 c = iri * (0.08 + 0.9 * fres) + vec3(1.0) * (glint * 1.6 + back * 0.25);
    // The light inside, through the film.
    c += material_params.core_color.rgb * material_params.core * pow(ndv, 3.0) * 0.35;
    material.base_color = vec4(c * material_params.fade, 1.0);
    PrepareMaterial(material);
  }
}
