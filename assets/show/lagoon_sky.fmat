// The night sky over the lagoon: a violet horizon rising to a deep navy
// zenith, two twinkling star layers, a little cloud texture, and the glow of
// the fireworks. The show feeds the brightest burst's direction and light
// into `flash`, which lights the haze around it and lifts the whole sky a
// touch, standing in for light scattering through the smoky air.

material {
  name: "LagoonSky",
  parameters: [
    { type: float, name: time, default: 0.0 },
    { type: vec4, name: horizon_color, default: [0.085, 0.052, 0.17, 1.0] },
    { type: vec4, name: zenith_color, default: [0.004, 0.008, 0.028, 1.0] },
    { type: float, name: star_brightness, hint: range(0, 3, 0.01), default: 1.0 },
    // xyz: direction toward the brightest burst, w: its light.
    { type: vec4, name: flash_dir, default: [0.0, 0.4, 1.0, 0.0] },
    // rgb: the combined color of everything burning right now.
    { type: vec4, name: flash_color, default: [0.0, 0.0, 0.0, 0.0] },
  ],
}

sky {
  float Hash1(vec3 p) {
    p = fract(p * 0.3183099 + vec3(0.1, 0.2, 0.3));
    p *= 17.0;
    return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
  }

  vec3 Hash3(vec3 p) {
    return vec3(Hash1(p), Hash1(p + 19.19), Hash1(p + 42.42));
  }

  float ValueNoise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float n000 = Hash1(i);
    float n100 = Hash1(i + vec3(1.0, 0.0, 0.0));
    float n010 = Hash1(i + vec3(0.0, 1.0, 0.0));
    float n110 = Hash1(i + vec3(1.0, 1.0, 0.0));
    float n001 = Hash1(i + vec3(0.0, 0.0, 1.0));
    float n101 = Hash1(i + vec3(1.0, 0.0, 1.0));
    float n011 = Hash1(i + vec3(0.0, 1.0, 1.0));
    float n111 = Hash1(i + vec3(1.0, 1.0, 1.0));
    return mix(mix(mix(n000, n100, f.x), mix(n010, n110, f.x), f.y),
               mix(mix(n001, n101, f.x), mix(n011, n111, f.x), f.y), f.z);
  }

  float Fbm(vec3 p) {
    float v = 0.0;
    float a = 0.5;
    for (int i = 0; i < 4; i++) {
      v += a * ValueNoise(p);
      p = p * 2.03 + 11.5;
      a *= 0.5;
    }
    return v;
  }

  vec3 Stars(vec3 d, float scale, float density) {
    vec3 p = d * scale;
    vec3 id = floor(p);
    vec3 h = Hash3(id);
    if (h.x > density) {
      return vec3(0.0);
    }
    vec3 star_pos = id + 0.5 + (h - 0.5) * 0.6;
    float dist = length(p - star_pos);
    float bright = pow(h.z, 10.0);
    float radius = 0.028 + 0.03 * bright;
    float shape = exp(-dist * dist / (radius * radius));
    float twinkle =
        0.75 + 0.3 * sin(material_params.time * (1.5 + 3.5 * h.y) + h.z * 40.0);
    vec3 tint = mix(vec3(1.0, 0.84, 0.66), vec3(0.74, 0.84, 1.0), Hash1(id + 7.7));
    return tint * shape * (0.4 + 5.0 * bright) * twinkle;
  }

  vec3 Sky(vec3 direction) {
    vec3 d = normalize(direction);
    float up = d.y;
    vec3 horizon = material_params.horizon_color.rgb;
    vec3 zenith = material_params.zenith_color.rgb;
    vec3 color = mix(horizon, zenith, pow(clamp(up, 0.0, 1.0), 0.45));
    color *= 0.9 + 0.2 * Fbm(d * 1.6 + 3.0);
    if (up < 0.0) {
      color = mix(horizon, vec3(0.004, 0.004, 0.01), clamp(-up * 3.0, 0.0, 1.0));
    }

    float extinction = smoothstep(0.0, 0.2, up);
    vec3 stars = Stars(d, 26.0, 0.11) + Stars(d, 64.0, 0.28) * 0.45;
    // Smoke and bright light wash the faint stars out.
    float wash = 1.0 / (1.0 + material_params.flash_dir.w * 0.8);
    color += stars * material_params.star_brightness * extinction * wash;

    // Thin high haze that the bursts light from behind.
    vec2 cp = d.xz / (up + 0.2);
    float haze = Fbm(vec3(cp * 0.7 + vec2(material_params.time * 0.004, 0.0), 1.0));
    haze = smoothstep(0.45, 0.85, haze) * smoothstep(0.0, 0.25, up);
    color = mix(color, color * 0.65 + vec3(0.012, 0.01, 0.02), haze * 0.5);

    // Firework light in the air: a soft lobe around the brightest burst, a
    // wider bloom, and a faint lift over the whole sky.
    vec3 fd = normalize(material_params.flash_dir.xyz + vec3(1e-5));
    float fw = material_params.flash_dir.w;
    float cosang = max(dot(d, fd), 0.0);
    vec3 fc = material_params.flash_color.rgb;
    color += fc * fw * (pow(cosang, 80.0) * 0.3 + pow(cosang, 14.0) * 0.05 + 0.006);
    color += fc * fw * haze * pow(cosang, 6.0) * 0.12;
    return color;
  }
}
