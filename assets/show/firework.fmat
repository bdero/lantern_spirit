// Firework light: star trails, star heads, shell tails, and glitter, all in
// one dynamic mesh built on the CPU every frame. Vertex color carries each
// point's burning color and brightness (HDR, so bloom catches it). The
// texture coordinate tells the shapes apart:
//   v in [0, 1]  a trail strip; u runs across it, v along it (0 tail, 1 head)
//   v in [2, 3]  a head or glint quad; (u, v - 2) span it
// Drawn additively, so overlapping light only ever brightens.

material {
  name: "Firework",
  shading_model: unlit,
  blending: additive,
  culling: none,
  parameters: [
    { type: float, name: intensity, hint: range(0, 8, 0.01), default: 1.0 },
  ],
}

fragment {
  void Surface(inout MaterialInputs material) {
    vec2 uv = GetUV0();
    vec4 vc = GetVertexColor();
    float shape;
    if (uv.y > 1.5) {
      // Round soft head: a hot core inside a wider glow.
      vec2 p = vec2(uv.x, uv.y - 2.0) * 2.0 - 1.0;
      float r2 = dot(p, p);
      shape = exp(-r2 * 9.0) * 1.6 + exp(-r2 * 3.0) * 0.35;
    } else {
      // Trail: soft across its width, brightening toward the head.
      float across = 1.0 - abs(uv.x * 2.0 - 1.0);
      shape = across * across * (0.25 + 0.75 * uv.y * uv.y);
    }
    material.base_color = vec4(vc.rgb * vc.a * shape * material_params.intensity, 1.0);
    PrepareMaterial(material);
  }
}
